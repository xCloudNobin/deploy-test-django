# Django taskboard runtime configuration.
# Copy to .env (or export in the platform environment) and adjust values.
# None of these values are secrets for production; set DJANGO_SECRET_KEY.

# Security
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: allowlist Origin/Referer for host-aware CSRF behind proxies.
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Server
PORT=8000
BIND_HOST=0.0.0.0
WEB_CONCURRENCY=2
TZ=UTC

# Persistence. DATABASE_NAME is an explicit persistent path or external DB
# volume; the app never stores data in an ephemeral release directory.
DATA_DIR=./data
DATABASE_NAME=./data/db.sqlite3

# Non-sensitive release marker shown in the UI footer (git SHA by default).
BUILD_MARKER=local

# Demo data (optional, idempotent):
#   python manage.py seed
#   python manage.py ensureuser --username demo --password your-password